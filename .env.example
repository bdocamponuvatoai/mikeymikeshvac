# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project → Settings → Environment Variables.

# ── Site URL and indexing ─────────────────────────────────────────────
# Canonical origin used for metadata, sitemap, robots and JSON-LD. No trailing slash.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL, so it is optional there,
# but set it in Production once the custom domain is live (e.g. https://www.example.com).
# Locally, setting it ALSO switches indexing on (used for Lighthouse SEO checks only).
NEXT_PUBLIC_SITE_URL=

# ── Quote form email delivery (optional) ──────────────────────────────
# With both RESEND_API_KEY and QUOTE_FROM_EMAIL set, the form emails requests through Resend
# and only reports "sent" after Resend confirms. With either missing, the form says plainly that
# nothing was sent and offers a prepared email and copy button instead.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Mikey Mike's website <quotes@example.com>"
QUOTE_FROM_EMAIL=
# Where requests go. Defaults to the business email in src/lib/site.ts.
QUOTE_TO_EMAIL=

# ── Set automatically by Vercel (do not set by hand) ─────────────────
# VERCEL_ENV                     production | preview | development; only production is indexable
# VERCEL_PROJECT_PRODUCTION_URL  production domain, used when NEXT_PUBLIC_SITE_URL is empty
